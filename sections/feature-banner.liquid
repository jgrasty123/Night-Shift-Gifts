{%- liquid
  assign scheme = section.settings.color_scheme | default: 'nightlight'
-%}
<section class="band band--tight-top scheme scheme--{{ scheme }}" id="{{ section.settings.anchor | default: 'feature' }}">
  <div class="wrap mix">
    <div class="mix__copy armed">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <div class="hero__actions">
          <a class="cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}
    </div>

    <div class="mix__art armed">
      {%- if section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}"
             alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
             width="560" height="510" loading="lazy">
      {%- else -%}
        <div class="mix__blank" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#moon"/></svg></div>
      {%- endif -%}

      {%- if section.settings.sticker_text != blank -%}
        {% render 'arc-sticker',
          text: section.settings.sticker_text,
          ring: 'var(--midnight)',
          ink: 'var(--gold)',
          modifier: 'sticker--mix',
          uid: section.id %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature banner",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "nightlight", "label": "Nightlight blue" },
        { "value": "blush", "label": "Dawn blush" },
        { "value": "midnight", "label": "Midnight" },
        { "value": "gold", "label": "Lamplight gold" }
      ],
      "default": "nightlight"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "feature" },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Every basket, booze-free or not" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop booze-free" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "sticker_text", "label": "Sticker text" }
  ],
  "presets": [{ "name": "Feature banner" }]
}
{% endschema %}
