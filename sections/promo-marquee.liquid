{%- liquid
  assign scheme = section.settings.color_scheme | default: 'midnight'
-%}
<div class="promo scheme scheme--{{ scheme }}" style="--speed:{{ section.settings.speed }}s" aria-label="Store announcements">
  <div class="promo__track">
    {%- for i in (1..2) -%}
      <div class="promo__group"{% if forloop.index == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          <svg class="hop" aria-hidden="true"><use href="#star"/></svg>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo marquee",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "midnight",
          "label": "Midnight"
        },
        {
          "value": "gold",
          "label": "Lamplight gold"
        },
        {
          "value": "nightlight",
          "label": "Nightlight blue"
        },
        {
          "value": "blush",
          "label": "Dawn blush"
        }
      ],
      "default": "midnight"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 38
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Gifts for the night shift"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo marquee",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Gifts for the night shift"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "New moms · New dads · Baby showers"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Shipping eligibility is confirmed at checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
