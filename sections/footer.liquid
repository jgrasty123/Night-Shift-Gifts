<footer class="foot scheme scheme--{{ section.settings.color_scheme | default: 'midnight' }}" id="{{ section.settings.anchor | default: 'footer' }}">
  <div class="wrap">
    <div class="foot__cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- when 'text' -%}
              <h4>{{ block.settings.heading }}</h4>
              <p style="font-size:.95rem;opacity:.85;max-width:34ch">{{ block.settings.text }}</p>

            {%- when 'menu' -%}
              <h4>{{ block.settings.heading }}</h4>
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'family' -%}
              <h4>{{ block.settings.heading }}</h4>
              {%- if block.settings.text != blank -%}
                <p style="font-size:.95rem;opacity:.85;max-width:34ch">{{ block.settings.text }}</p>
              {%- endif -%}
              <ul>
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign label_key = 'label_' | append: i
                    assign url_key = 'url_' | append: i
                    assign label = block.settings[label_key]
                    assign url = block.settings[url_key]
                  -%}
                  {%- if label != blank and url != blank -%}
                    <li><a href="{{ url }}">{{ label }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'newsletter' -%}
              <h4>{{ block.settings.heading }}</h4>
              {%- if block.settings.text != blank -%}
                <p style="font-size:.95rem;opacity:.85">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'signup' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="newsletter-email">{{ 'general.newsletter.placeholder' | t }}</label>
                <input id="newsletter-email" type="email" name="contact[email]"
                       placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
                <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
                {%- if form.posted_successfully? -%}
                  <p class="eyebrow" style="margin-top:.6rem">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.wordmark != blank -%}
      <p class="foot__word" aria-hidden="true">{{ section.settings.wordmark }}</p>
    {%- endif -%}

    <div class="foot__legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.city != blank %} · {{ section.settings.city }}{% endif %}</span>
      {%- if settings.age_notice != blank -%}<span>{{ settings.age_notice }}</span>{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "midnight",
          "label": "Midnight"
        },
        {
          "value": "nightlight",
          "label": "Nightlight blue"
        }
      ],
      "default": "midnight"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Outline wordmark",
      "default": "Night Shift"
    },
    {
      "type": "text",
      "id": "city",
      "label": "City line"
    }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Family of sites",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our other shops" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Same team, same Ventura warehouse." },
        { "type": "text", "id": "label_1", "label": "Link 1 label", "default": "The BroBasket \u2014 liquor gift baskets" },
        { "type": "url", "id": "url_1", "label": "Link 1 URL", "default": "https://thebrobasket.com" },
        { "type": "text", "id": "label_2", "label": "Link 2 label", "default": "Brew Hunters \u2014 craft beer & beer gifts" },
        { "type": "url", "id": "url_2", "label": "Link 2 URL", "default": "https://brewhunters.com" },
        { "type": "text", "id": "label_3", "label": "Link 3 label", "default": "BoozeFinders \u2014 wine & spirits" },
        { "type": "url", "id": "url_3", "label": "Link 3 URL", "default": "https://boozefinders.com" },
        { "type": "text", "id": "label_4", "label": "Link 4 label" },
        { "type": "url", "id": "url_4", "label": "Link 4 URL" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Night Shift Gift Co."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Gift baskets for new moms, new dads and baby showers."
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
