{%- liquid
  assign scheme = section.settings.color_scheme | default: 'cream'
-%}
<section class="band scheme scheme--{{ scheme }}" id="{{ section.settings.anchor | default: 'recipients' }}">
  <div class="wrap">
    <div class="band__head armed">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--wick">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
    </div>

    <div class="brews armed">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          assign count_label = block.settings.count_label
          if target != blank and count_label == blank
            if target.products_count == 1
              assign count_label = '1 gift'
            else
              assign count_label = target.products_count | append: ' gifts'
            endif
          endif
        -%}
        <a class="brew brew--{{ block.settings.tile_color }}"
           href="{{ target.url | default: block.settings.url | default: routes.all_products_collection_url }}"
           {{ block.shopify_attributes }}>
          <div>
            <h3>{{ block.settings.title | default: target.title }}</h3>
            {%- if block.settings.subtitle != blank -%}
              <p class="brew__sub">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
          <div class="brew__foot">
            <span>{{ count_label }}</span>
            <svg class="brew__moon" aria-hidden="true"><use href="#moon"/></svg>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Moon cream" },
        { "value": "paper", "label": "Paper" },
        { "value": "midnight", "label": "Midnight" }
      ],
      "default": "cream"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "recipients" },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who's on the night shift?" },
    { "type": "textarea", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "count_label", "label": "Count label override", "info": "Leave blank to use the live product count." },
        { "type": "url", "id": "url", "label": "Link override" },
        {
          "type": "select",
          "id": "tile_color",
          "label": "Tile color",
          "options": [
            { "value": "gold", "label": "Lamplight gold" },
            { "value": "nightlight", "label": "Nightlight blue" },
            { "value": "blush", "label": "Dawn blush" },
            { "value": "midnight", "label": "Midnight" },
            { "value": "paper", "label": "Paper" }
          ],
          "default": "gold"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "New moms", "tile_color": "blush" } },
        { "type": "tile", "settings": { "title": "New dads", "tile_color": "nightlight" } },
        { "type": "tile", "settings": { "title": "Baby showers", "tile_color": "gold" } },
        { "type": "tile", "settings": { "title": "Push presents", "tile_color": "midnight" } }
      ]
    }
  ]
}
{% endschema %}
