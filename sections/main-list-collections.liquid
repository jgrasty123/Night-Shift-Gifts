<section class="band scheme scheme--cream">
  <div class="wrap">
    <div class="band__head"><div><h2>Collections</h2></div></div>
    <div class="brews">
      {%- for collection in collections -%}
        <a class="brew{% cycle ' brew--blush', ' brew--nightlight', ' brew--gold', ' brew--midnight' %}" href="{{ collection.url }}">
          <div><h3>{{ collection.title }}</h3></div>
          <div class="brew__foot">
            <span>{{ collection.products_count }} {% if collection.products_count == 1 %}gift{% else %}gifts{% endif %}</span>
            <svg class="brew__moon" aria-hidden="true"><use href="#moon"/></svg>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "settings": []
}
{% endschema %}
